# 실제 값은 .env 에 넣는다 (저장소에 올리지 않는다).
#   cp .env.example .env
# vite 는 web/vite.config.js 의 envDir 설정으로 이 파일을 읽는다. VITE_ 접두사가
# 붙은 값만 브라우저로 내려간다.

# 카카오맵 JavaScript 키 - Kakao Developers > 내 애플리케이션 > 앱 키
# 브라우저에 노출되는 키다. 대신 Kakao Developers > 플랫폼 > Web 에 등록한
# 도메인(포트 포함)에서만 동작하므로, 등록 도메인 관리가 곧 보안이다.
VITE_KAKAO_JS_KEY=

# 브이월드 오픈API 키 - https://www.vworld.kr 인증키 발급
# tools/ 데이터 파이프라인에서만 쓰는 서버 키다. 브라우저로 내려가지 않는다.
VWORLD_KEY=
